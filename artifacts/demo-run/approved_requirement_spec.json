  "normalized_problem_statement": "v1: Provide short URLs that resolve to submitted long URLs.",
  "requirement_type": "greenfield",
  "assumptions": [
    "The workflow produces semantic artifacts without writing the service."
  ],
  "functional_requirements": [
    {
      "item_id": "FR-001",
      "lineage_id": "be48f8a5-272e-53be-99ed-2bc8ad178e19",
      "text": "Accept a long URL."
    },
    {
      "item_id": "FR-002",
      "lineage_id": "e9db0fcb-8282-5c3a-a069-d37ca328094b",
      "text": "Generate a unique short URL."
    },
    {
      "item_id": "FR-003",
      "lineage_id": "e49700e5-fd91-5507-b77a-04dd39c9e45d",
      "text": "Redirect the short URL to the original URL."
    },
    {
      "item_id": "FR-004",
      "lineage_id": "9c629bbf-a432-5855-89d3-4d873651d053",
      "text": "Return an error for unknown short URLs."
    }
  ],
  "nonfunctional_requirements": [
    {
      "item_id": "NFR-001",
      "lineage_id": "ce0289af-85a1-5191-a7b4-11ddb6c6736b",
      "text": "Short-code lookup should be reliable."
    }
  ],
  "constraints": [
    {
      "item_id": "CON-001",
      "lineage_id": "72f86821-b829-52bc-8125-7fc04e7ad4c5",
      "text": "The persistence technology is not yet selected."
    }
  ],
  "acceptance_criteria": [
    {
      "item_id": "AC-001",
      "lineage_id": "f3673e76-0d6c-5ee2-a196-638739b96b85",
      "text": "A submitted valid URL receives a unique short URL."
    },
    {
      "item_id": "AC-002",
      "lineage_id": "e3c6d089-dce4-5ae2-9ed6-b78c2499b062",
      "text": "An unknown short code returns a defined error."
    }
  ],
  "risks": [
    {
      "item_id": "RISK-001",
      "lineage_id": "4cb8fa83-79d9-5a90-a1eb-233986c00c37",
      "text": "Short-code collisions could produce incorrect redirects."
    }
  ],
  "ambiguities": [
    {
      "item_id": "AMB-001",
      "lineage_id": "514b318e-c096-5f18-a687-a794951ca0b2",
      "text": "URL expiration behavior is unspecified."
    }
  ]
}
